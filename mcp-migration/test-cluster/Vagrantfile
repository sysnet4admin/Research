# -*- mode: ruby -*-
# vi: set ft=ruby :

## configuration variables ##
# worker nodes: 2 (스케일아웃과 파드 재스케줄 측정에 최소 2개 필요)
N = 2
# each of components to install
k8s_V    = '1.36.2-2.1'                   # Kubernetes (1.36.2 빌드 리비전은 -2.1, -1.1 없음)
ctrd_V   = '2.2.3-1~ubuntu.24.04~noble'  # Containerd
## /configuration variables ##
#
# 이 클러스터는 192.168.2.0/24에 합류한다 (루트 CLAUDE.md IP 배정표 참조):
#   - 노드 IP   .150(CP), .151~.152(워커)   (agents-md는 .10번대라 충돌 없음)
#   - MetalLB   .230~.250                   (agents-md는 .200~.220)
#   - VBox 그룹 /mcp-migration
#   - VM 접미사 -mcpmig
#   - ssh 포워딩 60250~60252
# agents-md-migration 클러스터와 동시에 떠 있어도 IP와 이름이 겹치지 않는다.

Vagrant.configure("2") do |config|

  #====================#
  # Control-Plane Node #
  #====================#

    config.vm.define "cp-k8s-#{k8s_V[0..5]}" do |cfg|
      cfg.vm.box = "sysnet4admin/Ubuntu-k8s"
      cfg.vm.provider "virtualbox" do |vb|
        vb.name = "cp-k8s-#{k8s_V[0..5]}-mcpmig"
        vb.cpus = 2
        vb.memory = 4096
        vb.customize ["modifyvm", :id, "--groups", "/mcp-migration"]
      end
      cfg.vm.host_name = "cp-k8s"
      cfg.vm.network "private_network", ip: "192.168.2.150"
      cfg.vm.network "forwarded_port", guest: 22, host: 60250, auto_correct: true, id: "ssh"
      cfg.vm.synced_folder "../data", "/vagrant", disabled: true
      cfg.vm.provision "shell", path: "k8s_env_build.sh", args: [ N, k8s_V[0..3] ]
      cfg.vm.provision "shell", path: "k8s_pkg_cfg.sh", args: [ k8s_V, ctrd_V, "CP"]
      cfg.vm.provision "shell", path: "controlplane_node.sh"
      cfg.vm.provision "shell", path: "extra_k8s_pkgs.sh"
    end

  #==============#
  # Worker Nodes #
  #==============#

  (1..N).each do |i|
    config.vm.define "w#{i}-k8s-#{k8s_V[0..5]}" do |cfg|
      cfg.vm.box = "sysnet4admin/Ubuntu-k8s"
      cfg.vm.provider "virtualbox" do |vb|
        vb.name = "w#{i}-k8s-#{k8s_V[0..5]}-mcpmig"
        vb.cpus = 2
        vb.memory = 4096
        vb.customize ["modifyvm", :id, "--groups", "/mcp-migration"]
      end
      cfg.vm.host_name = "w#{i}-k8s"
      cfg.vm.network "private_network", ip: "192.168.2.15#{i}"
      cfg.vm.network "forwarded_port", guest: 22, host: "6025#{i}", auto_correct: true, id: "ssh"
      cfg.vm.synced_folder "../data", "/vagrant", disabled: true
      cfg.vm.provision "shell", path: "k8s_env_build.sh", args: [ N, k8s_V[0..3] ]
      cfg.vm.provision "shell", path: "k8s_pkg_cfg.sh", args: [ k8s_V, ctrd_V, "W" ]
      cfg.vm.provision "shell", path: "worker_nodes.sh"
    end
  end

end
