# -*- mode: ruby -*-
# vi: set ft=ruby :

## configuration variables ##
# worker nodes: 2
N = 2
# each of components to install
k8s_V    = '1.36.2-2.1'                   # Kubernetes (1.36.2 빌드 리비전은 -2.1)
ctrd_V   = '2.2.3-1~ubuntu.24.04~noble'  # Containerd
## /configuration variables ##
#
# cni-benchmark 전용 클러스터 (루트 CLAUDE.md IP 배정표 참조):
#   - 노드 IP   .50(CP), .51~.52(워커)   (agents-md .10번대, mcp .150번대와 충돌 없음)
#   - MetalLB   없음 (측정 잡음 최소화)
#   - VBox 그룹 /cni-benchmark
#   - VM 접미사 -cnibench
#   - ssh 포워딩 60350~60352
# 특징: CNI를 설치하지 않는 베이스. 조건별 CNI는 studies/ 설치 스크립트가 올린다.
# 베이스 스냅샷 시점에는 노드가 NotReady(정상, CNI 없음).

Vagrant.configure("2") do |config|

  #====================#
  # Control-Plane Node #
  #====================#

    config.vm.define "cp-k8s-#{k8s_V[0..5]}" do |cfg|
      cfg.vm.box = "sysnet4admin/Ubuntu-k8s"
      cfg.vm.provider "virtualbox" do |vb|
        vb.name = "cp-k8s-#{k8s_V[0..5]}-cnibench"
        vb.cpus = 2
        vb.memory = 4096
        vb.customize ["modifyvm", :id, "--groups", "/cni-benchmark"]
      end
      cfg.vm.host_name = "cp-k8s"
      cfg.vm.network "private_network", ip: "192.168.2.50"
      cfg.vm.network "forwarded_port", guest: 22, host: 60350, auto_correct: true, id: "ssh"
      cfg.vm.synced_folder "../data", "/vagrant", disabled: true
      cfg.vm.provision "shell", path: "k8s_env_build.sh", args: [ N, k8s_V[0..3] ]
      cfg.vm.provision "shell", path: "k8s_pkg_cfg.sh", args: [ k8s_V, ctrd_V, "CP"]
      cfg.vm.provision "shell", path: "controlplane_node.sh"
      cfg.vm.provision "shell", path: "extra_k8s_pkgs.sh"
    end

  #==============#
  # Worker Nodes #
  #==============#

  (1..N).each do |i|
    config.vm.define "w#{i}-k8s-#{k8s_V[0..5]}" do |cfg|
      cfg.vm.box = "sysnet4admin/Ubuntu-k8s"
      cfg.vm.provider "virtualbox" do |vb|
        vb.name = "w#{i}-k8s-#{k8s_V[0..5]}-cnibench"
        vb.cpus = 2
        vb.memory = 4096
        vb.customize ["modifyvm", :id, "--groups", "/cni-benchmark"]
      end
      cfg.vm.host_name = "w#{i}-k8s"
      cfg.vm.network "private_network", ip: "192.168.2.5#{i}"
      cfg.vm.network "forwarded_port", guest: 22, host: "6035#{i}", auto_correct: true, id: "ssh"
      cfg.vm.synced_folder "../data", "/vagrant", disabled: true
      cfg.vm.provision "shell", path: "k8s_env_build.sh", args: [ N, k8s_V[0..3] ]
      cfg.vm.provision "shell", path: "k8s_pkg_cfg.sh", args: [ k8s_V, ctrd_V, "W" ]
      cfg.vm.provision "shell", path: "worker_nodes.sh"
    end
  end

end
